#!/usr/bin/env python3
"""
ULTIMATE FIXED - Handles BOTH quoted strings AND variable references
"""

import re
import json
import os

def extract_field_value(field_name, content):
    """
    Extract field value - handles BOTH:
    1. Quoted strings: urdu: 'value',
    2. Variables: engheading: quranTopics[18].eng.capitalize(),
    """
    
    # Try pattern 1: Quoted string
    pattern1 = rf"{field_name}:\s*'([^']*)',"
    match1 = re.search(pattern1, content)
    if match1:
        return match1.group(1)
    
    # Try pattern 2: Variable reference (skip it, return empty)
    pattern2 = rf"{field_name}:\s*[a-zA-Z\[\]\.0-9()]+,"
    match2 = re.search(pattern2, content)
    if match2:
        return ''  # Return empty for variables
    
    return ''

def parse_words_data_from_content(content):
    """
    Parse WordsData objects - handles all formats
    """
    words = []
    
    # Find all WordsData objects
    pattern = r'WordsData\s*\((.*?)\s*\),'
    matches = re.finditer(pattern, content, re.DOTALL)
    
    for match in matches:
        obj_content = match.group(1)
        word = {}
        
        # Extract each field
        fields = ['urduheading', 'engheading', 'subheading', 'name', 'urdu', 'eng', 'g', 'n']
        
        for field in fields:
            word[field] = extract_field_value(field, obj_content)
        
        # Only add if it has a name
        if word.get('name', '').strip():
            words.append(word)
    
    return words

