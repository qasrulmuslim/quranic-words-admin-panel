def main():
    import sys
    
    print("\n🚀 Ultimate Dart to JSON Converter\n")
    
    if len(sys.argv) > 1:
        project_root = sys.argv[1]
    else:
        print("Enter project path:")
        project_root = input("Path: ").strip().strip('"').strip("'")
    
    if not os.path.exists(project_root):
        print(f"❌ Not found: {project_root}")
        return
    
    if not os.path.exists(os.path.join(project_root, 'lib')):
        print(f"❌ No 'lib' folder in: {project_root}")
        return
    
    print(f"✓ Project: {project_root}\n")
    convert_all_dart_files(project_root)

if __name__ == "__main__":
    main()